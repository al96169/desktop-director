# Rust
/target/

# macOS 构建产物（二进制 + bundle 不进仓库）
mac/build/
*.app

# Node
node_modules/
npm-debug.log*

# 本机状态（真实运行数据不进仓库）
.ddir/
*.log
audit.jsonl

# 测试隔离环境（含本机凭据，绝不入库）
.testhome/

# 构建产物
*.exe
*.pdb
*.obj
*.lib

# 编辑器
.vscode/
.idea/
*.swp
.install-rust.log

# 安装日志
.install-*.log

# 发布包要进仓库
!dist/*.exe
!dist/*.zip

# 运行时演示目录（`ddir demo` 生成的东西）；但跨平台的演示 playbook 要进仓库
demo/*
!demo/webdev/

